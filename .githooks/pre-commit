#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
git diff --cached --check
if git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)\.env($|\.(local|production|development|test)$)|\.(pem|p12|p8)$' >/dev/null; then
  echo "pre-commit: private environment/key file staged" >&2
  exit 1
fi
# Fast source checks; full build and browser tests remain in CI.
if git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(ts|tsx|js|jsx|mjs|cjs|json|css|scss)$' >/dev/null; then
  npm run check:staged
fi
